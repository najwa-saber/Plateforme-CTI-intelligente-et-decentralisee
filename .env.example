# =====================================================================
#  Intelligent Decentralized CTI Platform - environment template
#  Copy to .env and replace every "change-me" value, or simply run:
#      python scripts/generate_env.py        (creates .env with random secrets)
#  NEVER commit the real .env file (it is listed in .gitignore).
# =====================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------- PostgreSQL (application data, off-chain) ----------------
POSTGRES_DB=cti
POSTGRES_USER=cti
POSTGRES_PASSWORD=change-me
# Local (non-Docker) runs use SQLite by default; inside Docker the URL is built by docker-compose.
DATABASE_URL=sqlite:///./cti_dev.db

# ---------------- Simulated organisations (API keys = authentication) ----------------
ORG_A_NAME=Organisation A
ORG_B_NAME=Organisation B
ORG_C_NAME=Organisation C
ORG_A_API_KEY=change-me-org-a-key
ORG_B_API_KEY=change-me-org-b-key
ORG_C_API_KEY=change-me-org-c-key
# Ethereum accounts of the local Hardhat node used by each organisation (account 0 = consortium admin)
ORG_A_ACCOUNT_INDEX=1
ORG_B_ACCOUNT_INDEX=2
ORG_C_ACCOUNT_INDEX=3
# Optional: sign transactions locally instead of using node-unlocked accounts (leave empty)
ORG_A_PRIVATE_KEY=
ORG_B_PRIVATE_KEY=
ORG_C_PRIVATE_KEY=

# ---------------- Ethereum (local Hardhat network) ----------------
ETH_RPC_URL=http://127.0.0.1:8545
# ETH_DEPLOYMENT_FILE defaults to <project>/blockchain/deployments/localhost.json (Docker: /deployments/localhost.json)
# ETH_DEPLOYMENT_FILE=
ETH_AUTO_FINALIZE=true
VOTING_PERIOD_SECONDS=604800

# ---------------- MISP ----------------
# real = PyMISP only | simulated = development adapter | auto = real if reachable, else simulated (flagged in UI)
MISP_MODE=auto
# MISP_URL is used by local (non-Docker) runs; in Docker the backend uses MISP_INTERNAL_URL
MISP_URL=https://localhost:8443
MISP_INTERNAL_URL=https://misp-nginx:8443
MISP_PUBLIC_URL=https://localhost:8443
# 40-character API key, also used to initialise the MISP admin account (profile "misp")
MISP_KEY=change-me-40-characters-misp-api-key-xx
MISP_VERIFY_SSL=false
MISP_AUTO_PUSH=true
MISP_ADMIN_EMAIL=admin@cti-consortium.test
MISP_ADMIN_PASSWORD=change-me
MISP_DB_PASSWORD=change-me
MISP_DB_ROOT_PASSWORD=change-me
MISP_REDIS_PASSWORD=change-me

# ---------------- Upload limits ----------------
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=60

# ---------------- Reliability score S = wR R + wQ Q + wV V (CDC 10.1) ----------------
SCORE_WEIGHT_R=0.30
SCORE_WEIGHT_Q=0.30
SCORE_WEIGHT_V=0.40

# ---------------- Correlation (weights are normalised) ----------------
CORR_WEIGHT_IOC=0.45
CORR_WEIGHT_MITRE=0.20
CORR_WEIGHT_TEXT=0.20
CORR_WEIGHT_TIME=0.10
CORR_WEIGHT_CATEGORY=0.05
CORR_THRESHOLD=0.30
CORR_TIME_DECAY_DAYS=30
NEAR_DUPLICATE_THRESHOLD=0.92

# ---------------- Frontend (local run) ----------------
# 127.0.0.1 rather than localhost: on Windows "localhost" tries IPv6 (::1) first and Docker only binds 127.0.0.1 (~2 s per request)
API_URL=http://127.0.0.1:8000
